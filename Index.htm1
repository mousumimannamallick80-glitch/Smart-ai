<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart AI</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f2f5f9;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app {
      width: 100%;
      max-width: 500px;
      height: 100vh;
      max-height: 850px;
      background: white;
      display: flex;
      flex-direction: column;
      box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }

    .header {
      background: #2563eb;
      color: white;
      padding: 20px;
      text-align: center;
    }

    .header h1 {
      font-size: 26px;
    }

    .header p {
      margin-top: 5px;
      font-size: 14px;
      opacity: 0.9;
    }

    .chat {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
    }

    .message {
      max-width: 80%;
      padding: 12px 15px;
      margin-bottom: 12px;
      border-radius: 15px;
      line-height: 1.5;
      word-wrap: break-word;
    }

    .ai {
      background: #e9eef6;
      color: #222;
      margin-right: auto;
      border-bottom-left-radius: 4px;
    }

    .user {
      background: #2563eb;
      color: white;
      margin-left: auto;
      border-bottom-right-radius: 4px;
    }

    .input-area {
      display: flex;
      padding: 12px;
      border-top: 1px solid #ddd;
      background: white;
      gap: 8px;
    }

    #messageInput {
      flex: 1;
      padding: 13px;
      border: 1px solid #ccc;
      border-radius: 25px;
      outline: none;
      font-size: 16px;
    }

    #sendBtn {
      border: none;
      background: #2563eb;
      color: white;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      font-size: 20px;
      cursor: pointer;
    }

    #sendBtn:active {
      transform: scale(0.95);
    }

    .typing {
      font-size: 13px;
      color: #777;
      margin-bottom: 10px;
    }
  </style>
</head>

<body>

  <div class="app">

    <div class="header">
      <h1>🤖 Smart AI</h1>
      <p>Your AI Assistant</p>
    </div>

    <div class="chat" id="chat">

      <div class="message ai">
        👋 Hello! আমি Smart AI। আমাকে যেকোনো প্রশ্ন করতে পারো।
      </div>

    </div>

    <div class="input-area">
      <input
        type="text"
        id="messageInput"
        placeholder="আপনার প্রশ্ন লিখুন..."
      >

      <button id="sendBtn">➤</button>
    </div>

  </div>


  <script>

    const input = document.getElementById("messageInput");
    const sendBtn = document.getElementById("sendBtn");
    const chat = document.getElementById("chat");

    function addMessage(text, type) {

      const message = document.createElement("div");

      message.classList.add("message");
      message.classList.add(type);

      message.textContent = text;

      chat.appendChild(message);

      chat.scrollTop = chat.scrollHeight;
    }


    function sendMessage() {

      const text = input.value.trim();

      if (text === "") {
        return;
      }

      // User message
      addMessage(text, "user");

      input.value = "";

      // Temporary AI reply
      setTimeout(() => {

        addMessage(
          "আমি এখনো Backend-এর সাথে connected নই। পরের ধাপে আমাকে AI API-এর সাথে connect করা হবে। 🤖",
          "ai"
        );

      }, 700);
    }


    sendBtn.addEventListener("click", sendMessage);


    input.addEventListener("keypress", function(event) {

      if (event.key === "Enter") {
        sendMessage();
      }

    });

  </script>

</body>
  </html>
